<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SEND_SMS"/><uses-permission android:name="android.permission.RECEIVE_SMS"/><uses-permission android:name="android.permission.READ_SMS"/><uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:allowBackup="false" android:icon="@android:drawable/ic_menu_edit" android:label="Notes" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:label="Notes" android:windowSoftInputMode="adjustResize"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <receiver android:name=".SmsReceiver" android:enabled="true" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000"><action android:name="android.intent.action.DATA_SMS_RECEIVED"/><data android:scheme="sms"/><data android:host="localhost"/><data android:port="9999"/></intent-filter>
        </receiver>
    </application>
</manifest>
